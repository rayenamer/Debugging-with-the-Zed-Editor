[
  {
    "label": "Attach to Quarkus (port 5005)",
    "adapter": "Java",
    "request": "attach",
    "hostName": "localhost",
    "port": 5005
  },
  {
    "label": "Run Python service (port 8000)",
    "adapter": "Debugpy",
    "request": "launch",
    "module": "uvicorn",
    "args": ["main:app", "--port", "8000"],
    "cwd": "$ZED_WORKTREE_ROOT/python service",
    "python": "$ZED_WORKTREE_ROOT/python service/.venv/bin/python"
  }
]
